{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
	"id": "volumeDial",
	"items": [
		{
			"key": "status",
			"type": "text",
			"rect": [0, 4, 200, 14],
			"font": { "size": 11, "weight": 700 },
			"alignment": "center",
			"color": "#e5473b",
			"value": ""
		},
		{
			"key": "title",
			"type": "text",
			"rect": [4, 18, 192, 20],
			"font": { "size": 14, "weight": 600 },
