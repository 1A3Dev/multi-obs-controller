			"text-overflow": "ellipsis",
			"color": "#EFEFEF",
			"value": ""
		},
		{
			"key": "value",
			"type": "text",
			"rect": [4, 38, 192, 34],
			"font": { "size": 24, "weight": 600 },
			"alignment": "center",
			"color": "#EFEFEF",
			"value": ""
		},
		{
			"key": "indicator",
			"type": "bar",
			"rect": [8, 74, 184, 12],
			"subtype": 4,
			"border_w": 0,
			"bar_fill_c": "#EFEFEF",
			"value": 0
		}
	]
}
